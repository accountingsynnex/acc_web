# Keep formatting identical across editors. The app ships as plain files
# with no build step, so whitespace churn shows up directly in review diffs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Vendored libraries are upstream artefacts — never reformat them.
[app/vendor/**]
trim_trailing_whitespace = false
insert_final_newline = false
